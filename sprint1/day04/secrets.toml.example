# Streamlit Community Cloud: paste these lines into your app's
#   Settings -> Secrets   box (never commit real values to Git).
#
# Locally you can keep using the repo-root .env file instead, or copy this to
# .streamlit/secrets.toml in the folder you run `streamlit run` from.

# Optional - faster, rate-limit-free model downloads from Hugging Face.
HF_TOKEN = "hf_paste_your_token_here"

# Optional - "cloud" (lite models) or "local" (all features).
# Leave it out to auto-detect: Community Cloud gets "cloud", your computer gets "local".
# APP_PROFILE = "cloud"
